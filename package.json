{
  "name": "horizonjs-workspace",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "go run ./cmd/horizon build --tag main --docs go",
    "pack:library": "npm run build && npm pack ./build/npm --pack-destination ./build",
    "test:browser": "npm run build && node scripts/test-browser.mjs",
    "test:browser:firefox": "npm run build && node scripts/test-browser.mjs --firefox"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "vite": "8.3.4"
  }
}
